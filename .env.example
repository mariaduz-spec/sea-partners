# Sea Partners — variaveis de ambiente
# Copiar para .env.local e preencher. .env.local NAO eh commitado.

# Supabase (obter em https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — USAR SOMENTE EM SERVER-SIDE (Edge Functions, API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Nekt Data API — usar SOMENTE server-side. Nunca expor ao cliente.
NEKT_API_KEY=

# LLM Hub Seazone (LiteLLM gateway, OpenAI-compatible) — server-only
# Dashboard de keys: https://ai-portal.seazone.properties/dashboard
LLM_HUB_BASE_URL=https://hub.seazone.dev/v1
LLM_HUB_API_KEY=
# Modelo do Hub. apps-premium = Claude Haiku (cliente-facing, pt-BR). Alternativas: apps-chat, claude-sonnet.
LLM_HUB_MODEL=apps-premium

# Pipedrive — server-only
PIPEDRIVE_API_TOKEN=
